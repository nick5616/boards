# Copy to .env.local (ignored by git) to change these.

# Store boards as shareable "spaces" (spaces/{id} + one doc per module) instead
# of one doc per board. Leave off (or unset) until firestore.rules and
# firestore.indexes.json are deployed, or the app will be refused access.
# Turning it on migrates your boards on next sign-in; the old copies stay put.
#
# Sharing a board (share links, "look only" guests) also needs, once, by hand:
#   1. firebase deploy --only firestore:rules   (invites, member rows, the new checks)
#   2. Firebase console > Authentication > Sign-in method > turn on "Anonymous"
#      (look-only links open without an account by signing in a nameless guest)
#   3. Authentication > Settings > Authorized domains: add the domain the app is served from
VITE_SPACES=0
