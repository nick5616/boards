# Copy to .env.local (ignored by git) to change these.

# Store boards as shareable "spaces" (spaces/{id} + one doc per module) instead
# of one doc per board. Leave off (or unset) until firestore.rules and
# firestore.indexes.json are deployed, or the app will be refused access.
# Turning it on migrates your boards on next sign-in; the old copies stay put.
VITE_SPACES=0
